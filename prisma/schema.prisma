generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  hr
  super_admin
}

enum ProjectStatus {
  ideation
  refining
  scoped
  planned
  in_progress
  completed
}

enum JobStatus {
  open
  closed
  on_hold
}

enum ApplicantStatus {
  new
  reviewed
  shortlisted
  rejected
  hired
}

enum Recommendation {
  strong_match
  match
  partial_match
  weak_match
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?   @map("password_hash")
  name         String?
  role         Role      @default(user)
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  projects        Project[]
  jobOpenings     JobOpening[]
  uploadedResumes Applicant[]    @relation("UploadedResumes")
  settingsUpdates SystemSetting[]
  apiUsage        ApiUsage[]
  accounts        Account[]
  sessions        Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Project {
  id          String        @id @default(cuid())
  userId      String        @map("user_id")
  name        String        @db.VarChar(500)
  description String?
  status      ProjectStatus @default(ideation)
  metadata    Json          @default("{}")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  apiUsage ApiUsage[]

  @@map("projects")
}

model Message {
  id           String   @id @default(cuid())
  projectId    String   @map("project_id")
  role         String
  content      String   @db.Text
  tokensInput  Int      @default(0) @map("tokens_input")
  tokensOutput Int      @default(0) @map("tokens_output")
  model        String?  @db.VarChar(100)
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model JobOpening {
  id           String    @id @default(cuid())
  createdById  String    @map("created_by_id")
  title        String    @db.VarChar(500)
  department   String?   @db.VarChar(255)
  location     String?   @db.VarChar(255)
  employmentType String? @map("employment_type") @db.VarChar(100)
  experienceLevel String? @map("experience_level") @db.VarChar(100)
  description  String    @db.Text
  requirements Json      @default("{}")
  status       JobStatus @default(open)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  createdBy  User        @relation(fields: [createdById], references: [id], onDelete: Cascade)
  applicants Applicant[]

  @@index([createdById])
  @@map("job_openings")
}

model Applicant {
  id              String           @id @default(cuid())
  jobId           String           @map("job_id")
  uploadedById    String           @map("uploaded_by_id")
  name            String           @db.VarChar(255)
  email           String?          @db.VarChar(255)
  phone           String?          @db.VarChar(50)
  location        String?          @db.VarChar(255)
  resumeFileName  String?          @map("resume_file_name") @db.VarChar(500)
  resumeMime      String?          @map("resume_mime") @db.VarChar(100)
  resumeText      String?          @map("resume_text") @db.Text
  parsedData      Json             @default("{}") @map("parsed_data")
  score           Decimal?         @db.Decimal(5, 2)
  recommendation  Recommendation?
  remarks         Json             @default("{}")
  status          ApplicantStatus  @default(new)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  job          JobOpening    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  uploadedBy   User          @relation("UploadedResumes", fields: [uploadedById], references: [id])
  analysisRuns AnalysisRun[]

  @@index([jobId])
  @@index([email])
  @@map("applicants")
}

model AnalysisRun {
  id           String   @id @default(cuid())
  applicantId  String   @map("applicant_id")
  score        Decimal? @db.Decimal(5, 2)
  recommendation Recommendation?
  result       Json     @default("{}")
  model        String?  @db.VarChar(100)
  tokensInput  Int      @default(0) @map("tokens_input")
  tokensOutput Int      @default(0) @map("tokens_output")
  createdAt    DateTime @default(now()) @map("created_at")

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicantId])
  @@map("analysis_runs")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(255)
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  updater User? @relation(fields: [updatedBy], references: [id])

  @@map("system_settings")
}

model ApiUsage {
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  projectId    String?  @map("project_id")
  feature      String?  @db.VarChar(100)
  model        String?  @db.VarChar(100)
  tokensInput  Int?     @map("tokens_input")
  tokensOutput Int?     @map("tokens_output")
  costUsd      Decimal? @map("cost_usd") @db.Decimal(10, 6)
  webSearches  Int      @default(0) @map("web_searches")
  createdAt    DateTime @default(now()) @map("created_at")

  user    User?    @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@map("api_usage")
}
