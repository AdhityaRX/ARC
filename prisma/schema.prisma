generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  super_admin
}

enum ProjectStatus {
  ideation
  refining
  scoped
  planned
  in_progress
  completed
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?   @map("password_hash")
  name         String?
  role         Role      @default(user)
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  projects       Project[]
  settingsUpdates SystemSetting[]
  apiUsage       ApiUsage[]
  accounts       Account[]
  sessions       Session[]
  monitoringSessions MonitoringSession[]
  activityLogs       ActivityLog[]
  screenshots        Screenshot[]
  monitoringConfig   MonitoringConfig?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Project {
  id          String        @id @default(cuid())
  userId      String        @map("user_id")
  name        String        @db.VarChar(500)
  description String?
  status      ProjectStatus @default(ideation)
  metadata    Json          @default("{}")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  apiUsage ApiUsage[]

  @@map("projects")
}

model Message {
  id           String   @id @default(cuid())
  projectId    String   @map("project_id")
  role         String
  content      String   @db.Text
  tokensInput  Int      @default(0) @map("tokens_input")
  tokensOutput Int      @default(0) @map("tokens_output")
  model        String?  @db.VarChar(100)
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(255)
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  updater User? @relation(fields: [updatedBy], references: [id])

  @@map("system_settings")
}

model ApiUsage {
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  projectId    String?  @map("project_id")
  model        String?  @db.VarChar(100)
  tokensInput  Int?     @map("tokens_input")
  tokensOutput Int?     @map("tokens_output")
  costUsd      Decimal? @map("cost_usd") @db.Decimal(10, 6)
  webSearches  Int      @default(0) @map("web_searches")
  createdAt    DateTime @default(now()) @map("created_at")

  user    User?    @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@map("api_usage")
}

enum MonitoringStatus {
  online
  idle
  offline
}

model MonitoringSession {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  status    MonitoringStatus @default(offline)
  machineId String?          @map("machine_id") @db.VarChar(255)
  hostname  String?          @db.VarChar(255)
  ipAddress String?          @map("ip_address") @db.VarChar(45)
  startedAt DateTime         @default(now()) @map("started_at")
  endedAt   DateTime?        @map("ended_at")
  lastHeartbeat DateTime     @default(now()) @map("last_heartbeat")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("monitoring_sessions")
}

model ActivityLog {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  periodStart    DateTime @map("period_start")
  periodEnd      DateTime @map("period_end")
  mouseClicks    Int      @default(0) @map("mouse_clicks")
  mouseDistance   Int      @default(0) @map("mouse_distance")
  keystrokes     Int      @default(0)
  scrollEvents   Int      @default(0) @map("scroll_events")
  activeWindowTitle String? @map("active_window_title") @db.VarChar(500)
  activeAppName  String?  @map("active_app_name") @db.VarChar(255)
  isIdle         Boolean  @default(false) @map("is_idle")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, periodStart])
  @@map("activity_logs")
}

model Screenshot {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  fileName  String   @map("file_name") @db.VarChar(255)
  filePath  String   @map("file_path") @db.VarChar(1000)
  fileSize  Int?     @map("file_size")
  width     Int?
  height    Int?
  activeWindowTitle String? @map("active_window_title") @db.VarChar(500)
  capturedAt DateTime @default(now()) @map("captured_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, capturedAt])
  @@map("screenshots")
}

model MonitoringConfig {
  id                    String  @id @default(cuid())
  userId                String? @unique @map("user_id")
  screenshotIntervalMin Int     @default(5) @map("screenshot_interval_min")
  trackMouseClicks      Boolean @default(true) @map("track_mouse_clicks")
  trackKeystrokes       Boolean @default(true) @map("track_keystrokes")
  trackMouseMovement    Boolean @default(true) @map("track_mouse_movement")
  trackActiveWindow     Boolean @default(true) @map("track_active_window")
  trackScreenshots      Boolean @default(true) @map("track_screenshots")
  idleTimeoutMin        Int     @default(5) @map("idle_timeout_min")
  isEnabled             Boolean @default(true) @map("is_enabled")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("monitoring_configs")
}
