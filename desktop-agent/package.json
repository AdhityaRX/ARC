{
  "name": "arc-monitor-agent",
  "version": "1.0.0",
  "description": "ARC Employee Monitoring Agent - Transparent workplace monitoring",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "electron dist/main.js",
    "dev": "tsc && electron dist/main.js",
    "pack": "electron-builder --win --dir",
    "dist": "tsc && electron-builder --win"
  },
  "build": {
    "appId": "com.arc.monitor-agent",
    "productName": "ARC Monitor",
    "copyright": "ARC Monitoring System",
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "node-fetch": "^2.7.0",
    "form-data": "^4.0.0",
    "active-win": "^8.1.0",
    "screenshot-desktop": "^1.15.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "@types/node": "^20.10.0"
  }
}
